    {
      "type": "stat",
      "title": "Checks",
      "id": 8,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "description": "Recomputed in SQL from the stored rows, over the whole table (the time range is ignored, since every row depends on the symbol's previous one). Takes a few seconds. Comparison with the pandas reference (reference/) is done offline.",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "WITH w AS (\n  SELECT *, lag(ema38) OVER s AS l38, lag(ema100) OVER s AS l100, lag(window_end) OVER s AS lend\n  FROM ema_window WINDOW s AS (PARTITION BY symbol ORDER BY window_end))\nSELECT\n  count(*) FILTER (WHERE abs(ema38 - (close * (2.0 / 39) + prev_ema38 * (1 - 2.0 / 39))) > 1e-9 * greatest(abs(ema38), 1)\n                      OR abs(ema100 - (close * (2.0 / 101) + prev_ema100 * (1 - 2.0 / 101))) > 1e-9 * greatest(abs(ema100), 1))\n    AS \"EMA formula (FR-11)\",\n  count(*) FILTER (WHERE (lend IS NULL AND (prev_ema38 <> 0 OR prev_ema100 <> 0))\n                      OR (lend IS NOT NULL AND (prev_ema38 <> l38 OR prev_ema100 <> l100)))\n    AS \"Start at 0, state carried (FR-12/13)\",\n  count(*) FILTER (WHERE advisory IS DISTINCT FROM CASE WHEN ema38 > ema100 AND prev_ema38 <= prev_ema100 THEN 'BUY'\n                                                         WHEN ema38 < ema100 AND prev_ema38 >= prev_ema100 THEN 'SELL' END)\n    AS \"Advisory iff crossover (FR-15/16)\",\n  count(*) FILTER (WHERE window_end - window_start <> interval '5 minutes'\n                      OR extract(epoch FROM window_start)::bigint % 300 <> 0)\n    AS \"5-min windows from midnight (FR-5..7)\",\n  count(*) FILTER (WHERE close <= 0) AS \"Zero or negative closes\",\n  count(*) FILTER (WHERE initial IS DISTINCT FROM (advisory IS NOT NULL AND prev_ema38 = 0 AND prev_ema100 = 0))\n    AS \"initial flag\"\nFROM w",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
