    {
      "type": "row",
      "title": "Correctness checks on the stored output (NFR-9): each must be 0",
      "id": 7,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
