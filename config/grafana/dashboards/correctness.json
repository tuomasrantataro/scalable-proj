          "rawSql": "SELECT event_time AS \"Event time\", reason AS \"Reason\", symbol AS \"Symbol\", price AS \"Price\", detail AS \"Detail\", kafka_partition AS \"Partition\", kafka_offset AS \"Offset\" FROM data_issue WHERE reason IN ($reason) AND $__timeFilter(event_time) ORDER BY event_time DESC, symbol LIMIT 500",
