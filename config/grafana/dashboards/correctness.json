          "rawSql": "SELECT symbol AS \"Symbol\", count(*) AS \"Jumps\", min(price) AS \"Min close\", max(price) AS \"Max close\" FROM data_issue WHERE reason = 'PRICE_JUMP' AND $__timeFilter(event_time) GROUP BY symbol ORDER BY 2 DESC LIMIT 50",
