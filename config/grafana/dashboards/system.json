    {
      "type": "timeseries",
      "title": "Busy time per task and subtask",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "ms per second a task is busy (1000 = saturated). The busiest task limits throughput. The Iggy source shows 1000 even when idle: the connector's reader busy-polls (architecture \u00a74.1).",
