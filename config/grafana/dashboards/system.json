        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(flink_taskmanager_job_task_busyTimeMsPerSecond, \"task\", \"$1\", \"task_name\", \"(Source|window_5min|ema|timescaledb_issues).*\")",
          "legendFormat": "{{task}} #{{subtask_index}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
