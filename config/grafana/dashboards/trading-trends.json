    {
      "type": "table",
      "title": "Latest advisories",
      "id": 9,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "description": "Newest first, at most 500 (FR-18: symbol, type, window). Spread = (EMA38 \u2212 EMA100) / EMA100 just after the crossover. Click a symbol to open it.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT window_end AS \"Due at\", symbol AS \"Symbol\", advisory AS \"Type\", close AS \"Close\", ema38 AS \"EMA38\", ema100 AS \"EMA100\", round(((ema38 - ema100) / nullif(ema100, 0) * 100)::numeric, 4) AS \"Spread %\", initial AS \"Initial\", emitted_at AS \"Emitted (wall clock, UTC)\" FROM ema_window WHERE advisory IS NOT NULL AND symbol LIKE ANY (ARRAY[$exchange]) AND sec_type IN ($sec_type) AND (NOT initial OR '$initial' = 'show') AND $__timeFilter(window_end) ORDER BY window_end DESC, symbol LIMIT 500",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Type"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "BUY": {
                        "color": "#37872d",
                        "text": "\u25b2 BUY",
                        "index": 0
                      },
                      "SELL": {
                        "color": "#c4162a",
                        "text": "\u25bc SELL",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Symbol"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show ${__value.raw}",
                    "url": "/d/trading-trends/trading-trends?${__url_time_range}&${exchange:queryparam}&${sec_type:queryparam}&${initial:queryparam}&var-symbol=${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
