              "title": "Show ${__data.fields.symbol}",
              "url": "/d/trading-trends/trading-trends?${__url_time_range}&${exchange:queryparam}&${sec_type:queryparam}&${initial:queryparam}&var-symbol=${__data.fields.symbol}"
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "BUY"
            },
            "properties": [
              {
                "id": "color",
