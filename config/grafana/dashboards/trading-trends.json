            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisBorderShow": false,
            "lineInterpolation": "linear",
            "thresholdsStyle": {
              "mode": "line"
            },
            "insertNulls": 1800000
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#c4162a",
                "value": null
              },
              {
                "color": "#37872d",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
