            "matcher": {
              "id": "byName",
              "options": "SELL"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c4162a"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "barchart",
      "title": "Most advisories (top 15 symbols)",
      "id": 8,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "description": "Symbols whose EMAs cross most often: either strongly trending reversals or whipsaw (a price oscillating around the EMAs). Click a bar to open the symbol.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT symbol, count(*) FILTER (WHERE advisory = 'BUY') AS \"BUY\", count(*) FILTER (WHERE advisory = 'SELL') AS \"SELL\" FROM ema_window WHERE advisory IS NOT NULL AND symbol LIKE ANY (ARRAY[$exchange]) AND sec_type IN ($sec_type) AND (NOT initial OR '$initial' = 'show') AND $__timeFilter(window_end) GROUP BY symbol ORDER BY count(*) DESC, symbol LIMIT 15",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
