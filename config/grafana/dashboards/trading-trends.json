    {
      "type": "stat",
      "title": "Last close",
      "id": 11,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "description": "At the end of the time range.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT close AS \"Close\" FROM ema_window WHERE symbol = '$symbol' AND window_end <= $__timeTo() ORDER BY window_end DESC LIMIT 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
