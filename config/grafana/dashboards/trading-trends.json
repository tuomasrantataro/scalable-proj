  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "BUY ($symbol)",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "enable": true,
        "iconColor": "#37872d",
        "filter": {
          "exclude": false,
          "ids": [
            101,
            102
          ]
        },
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT window_end AS time, '\u25b2 BUY' || CASE WHEN initial THEN ' (initial)' ELSE '' END || ' close ' || close AS text FROM ema_window WHERE symbol = '$symbol' AND advisory = 'BUY' AND $__timeFilter(window_end)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      },
      {
        "name": "SELL ($symbol)",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "enable": true,
        "iconColor": "#c4162a",
        "filter": {
          "exclude": false,
          "ids": [
            101,
            102
          ]
        },
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT window_end AS time, '\u25bc SELL close ' || close AS text FROM ema_window WHERE symbol = '$symbol' AND advisory = 'SELL' AND $__timeFilter(window_end)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      },
      {
        "name": "EMA38 warm-up ($symbol)",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "enable": true,
        "iconColor": "rgba(128,128,128,0.10)",
        "filter": {
          "exclude": false,
          "ids": [
            101,
            102,
            103
          ]
        },
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "WITH s AS (SELECT window_start, window_end, row_number() OVER (ORDER BY window_end) AS n FROM ema_window WHERE symbol = '$symbol') SELECT min(window_start) AS time, max(window_end) AS \"timeEnd\", 'EMA38 warm-up: first 88 windows' AS text FROM s WHERE n <= 88",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      },
      {
        "name": "EMA100 warm-up ($symbol)",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "enable": true,
        "iconColor": "rgba(128,128,128,0.10)",
        "filter": {
          "exclude": false,
          "ids": [
            101,
            102,
            103
          ]
        },
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "WITH s AS (SELECT window_start, window_end, row_number() OVER (ORDER BY window_end) AS n FROM ema_window WHERE symbol = '$symbol') SELECT min(window_start) AS time, max(window_end) AS \"timeEnd\", 'EMA100 warm-up: first 231 windows' AS text FROM s WHERE n <= 231",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      }
    ]
  },
