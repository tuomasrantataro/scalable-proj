    {
      "type": "timeseries",
      "title": "EMA spread \u2014 $symbol",
      "id": 102,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "description": "Above 0 = EMA38 over EMA100 (bullish), below = bearish. Each zero crossing is an advisory. The y-axis is scaled to the values after the EMA100 warm-up; during warm-up the spread runs off the top.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT window_end AS time, (ema38 - ema100) / nullif(ema100, 0) * 100 AS \"(EMA38 \u2212 EMA100) / EMA100\" FROM ema_window WHERE symbol = '$symbol' AND $__timeFilter(window_end) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "WITH s AS (SELECT (ema38 - ema100) / nullif(ema100, 0) * 100 AS v, row_number() OVER (ORDER BY window_end) AS n, window_end FROM ema_window WHERE symbol = '$symbol') SELECT -greatest(max(abs(v)), 0.01) * 1.1 AS min, greatest(max(abs(v)), 0.01) * 1.1 AS max FROM s WHERE n > 231 AND $__timeFilter(window_end)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "scheme",
