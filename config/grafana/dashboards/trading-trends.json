            "configRefId": "B",
            "applyTo": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "mappings": [
              {
                "fieldName": "min",
                "handlerKey": "min"
              },
              {
                "fieldName": "max",
                "handlerKey": "max"
              }
            ]
          }
        }
      ]
    },
