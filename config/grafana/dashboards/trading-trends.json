      "options": {
        "mode": "markdown",
        "content": "An advisory is an EMA38/EMA100 crossover in a 5-minute window, due at the window end (FR-8). Click a symbol to open it below. Times: exchange local time, shown as UTC. All symbols are shown; delivery to traders is filtered by `config/subscriptions.txt`."
      }
    },
    {
      "type": "timeseries",
      "title": "Advisories per hour",
      "id": 7,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "description": "When crossovers cluster. BUY up, SELL down (counted negative). Many simultaneous advisories of one kind mean a market-wide move rather than symbol news.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT $__timeGroupAlias(window_end, '1h'), count(*) FILTER (WHERE advisory = 'BUY') AS \"BUY\", -count(*) FILTER (WHERE advisory = 'SELL') AS \"SELL\" FROM ema_window WHERE advisory IS NOT NULL AND symbol LIKE ANY (ARRAY[$exchange]) AND sec_type IN ($sec_type) AND (NOT initial OR '$initial' = 'show') AND $__timeFilter(window_end) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisBorderShow": false,
            "barAlignment": 0,
            "gradientMode": "none",
            "spanNulls": false,
            "axisCenteredZero": true
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "BUY"
            },
            "properties": [
              {
                "id": "color",
                "value": {
